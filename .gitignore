# An * ensures that everything will be ignored by default
*

# Explicit folder whitelist
!.claude/
!.claude/**
!packages/
!automation/
!themes/
!blueprints/
!blueprints/**
!sensor/
!script/
!scene/
!dashboards/
!dashboards/**
!www/
!www/backgrounds/
!www/backgrounds/**
!www/fonts/
!www/fonts/**

# Explicit file whitelist
!*.yaml
!.gitignore
!.yamllint
!.gitattributes
!.gitkeep
!*.md

# Only www/backgrounds/ and www/fonts/ are tracked; the rest of www/ stays local
www/*
!www/backgrounds/
!www/fonts/

# Specific folder ignores
custom_components/
www/community/
__pycache__/
*.pyc
blueprints/**/homeassistant/

# Specific file ignores
ip_bans.yaml
secrets.yaml
known_devices.yaml
*.local.md
*.local.json