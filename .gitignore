# An * ensures that everything will be ignored by default
*

# Explicit folder whitelist
!.claude/
!.claude/**
!packages/
!automation/
!themes/
!blueprints/
!blueprints/**
!sensor/
!script/
!scene/
!dashboards/
!dashboards/**
# www/: only backgrounds/ and fonts/ are tracked (each needs its dir and its contents re-included)
!www/
www/*
!www/backgrounds/
!www/backgrounds/**
!www/fonts/
!www/fonts/**

# Explicit file whitelist
!*.yaml
!.gitignore
!.yamllint
!.gitattributes
!.gitkeep
!*.md

# Specific folder ignores
.claude/plans/
.claude/specs/
custom_components/
__pycache__/
*.pyc
blueprints/**/homeassistant/

# Specific file ignores
ip_bans.yaml
secrets.yaml
known_devices.yaml
*.local.md
*.local.json